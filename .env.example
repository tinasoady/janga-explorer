# Copier ce fichier en .env.local puis renseigner les valeurs.
# Sans les variables Supabase, l'application affiche les données de démonstration
# (les comptes, l'espace pro, l'administration et les alertes sont alors indisponibles).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Numéro WhatsApp qui reçoit les demandes des professionnels (format international sans "+", ex : 261341234567)
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Facultatif : URL publique du site, utilisée dans les e-mails de confirmation de compte.
# Par défaut, elle est déduite de la requête (ex : https://janga-explorer.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Facultatif : e-mail envoyé au superadmin à chaque demande de compte pro (service Resend, https://resend.com).
# Sans ces variables, rien n'est envoyé : les demandes restent visibles dans /admin/demandes.
# Ces trois valeurs sont secrètes : ne les préfixez jamais par NEXT_PUBLIC_.
RESEND_API_KEY=
SUPERADMIN_NOTIFY_EMAIL=
# Expéditeur. Par défaut « Janga Explorer <onboarding@resend.dev> », qui ne peut écrire qu'à l'adresse du compte Resend.
MAIL_FROM=
